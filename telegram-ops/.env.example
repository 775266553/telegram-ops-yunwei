APP_NAME="Telegram Ops Workbench"
APP_SECRET_KEY="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
ENCRYPTION_KEY="CHANGE_ME_WITH_A_FERNET_KEY"
DATABASE_URL="sqlite:///./telegram_ops.db"
AUTO_START_TELEGRAM_WORKERS=false
CONFIG_RELOAD_SECONDS=10
HEALTH_CHECK_SECONDS=30
QUEUE_POLL_SECONDS=3
QUEUE_BATCH_SIZE=10

# Conservative outbound defaults. Raise limits only after reviewing account health.
DEFAULT_ACCOUNT_DAILY_LIMIT=20
DEFAULT_USER_DAILY_LIMIT=1
DEFAULT_USER_COOLDOWN_SECONDS=86400
OUTBOUND_DELAY_MIN_SECONDS=20
OUTBOUND_DELAY_MAX_SECONDS=90
OUTBOUND_MIN_INTERVAL_SECONDS=45
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_BASE_SECONDS=60
OUTBOUND_RETRY_MAX_SECONDS=1800

ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH="SET_A_SCRYPT_PASSWORD_HASH"
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=false
ADMIN_ALLOWED_IPS=""
